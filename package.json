{
  "name": "eye-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:workflows": "node scripts/validate-workflows.mjs",
    "test:unit": "node --test tests/unit/*.test.js tests/automation/*.test.js",
    "test:browser": "playwright test",
    "test": "npm run check:syntax && npm run check:workflows && npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "axe-core": "4.14.0",
    "yaml": "2.9.1"
  }
}
